{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"name": {
			"type": "string"
		},
		"description": {
			"type": "string"
		},
		"items": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9._-]*$"
					},
					"description": {
						"type": "string"
					},
					"itemDependencies": {
						"description": "Item URLs to install before this registry item.",
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"dependencies": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"devDependencies": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"files": {
						"type": "array",
						"items": {
							"anyOf": [
								{
									"type": "object",
									"properties": {
										"type": {
											"type": "string",
											"enum": [
												"file",
												"url"
											]
										},
										"path": {
											"type": "string",
											"minLength": 1
										},
										"target": {
											"type": "string",
											"minLength": 1
										},
										"isLocalBinary": {
											"not": {}
										},
										"content": {
											"not": {}
										}
									},
									"required": [
										"type",
										"path"
									],
									"additionalProperties": false
								},
								{
									"type": "object",
									"properties": {
										"type": {
											"type": "string",
											"const": "file"
										},
										"content": {
											"type": "string",
											"description": "Contains inline text to write to the target file."
										},
										"target": {
											"type": "string",
											"minLength": 1
										},
										"path": {
											"not": {}
										},
										"isLocalBinary": {
											"not": {}
										}
									},
									"required": [
										"type",
										"content",
										"target"
									],
									"additionalProperties": false
								}
							]
						}
					}
				},
				"required": [
					"name",
					"files"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"name",
		"items"
	],
	"additionalProperties": false
}
